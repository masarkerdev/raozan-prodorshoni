# ---- Supabase ডেটাবেস (Connect বাটন > ORMs > Prisma থেকে কপি করুন) ----
# Transaction pooler (port 6543) — অ্যাপ চলার সময় ব্যবহৃত
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct / Session connection (port 5432) — টেবিল তৈরি ও মাইগ্রেশনে ব্যবহৃত
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ---- Supabase API (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon / publishable key]"
# ছবি রাখার জন্য (Project Settings > API Keys > Secret key) — কখনো কাউকে দেখাবেন না
SUPABASE_SERVICE_ROLE_KEY="[secret key]"

# ---- প্রথম অ্যাডমিন (seed চালানোর সময় তৈরি হবে) ----
ADMIN_EMAIL="you@example.com"
ADMIN_NAME="আপনার নাম"
